# Claude API — synthesis and web search
ANTHROPIC_API_KEY=

# Alpha Vantage — market quotes (free tier, 25 req/day)
ALPHAVANTAGE_API_KEY=

# Resend — email delivery
RESEND_API_KEY=
NEWSLETTER_TO=you@example.com

# Discord — total-failure alerts only
DISCORD_WEBHOOK_URL=

# Password gate for the published site
SITE_PASSWORD=

# Signs the session cookie issued on login (generate with `openssl rand -hex 32`).
# Rotating this instantly invalidates every issued session.
SESSION_SECRET=

# Push notifications — VAPID key pair (generate with `npx web-push generate-vapid-keys`)
# Public key is safe to expose client-side; also set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Fine-grained GitHub PAT (Contents: Read and write, scoped to this repo) —
# lets /api/subscribe commit the push subscription straight into the repo
# Named GH_PAT, not GITHUB_PAT — GitHub reserves the GITHUB_ prefix for its own secrets
GH_PAT=
